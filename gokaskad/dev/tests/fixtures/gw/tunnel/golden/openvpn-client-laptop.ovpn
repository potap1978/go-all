# Kaskad · Ноутбук · OpenVPN
client
dev tun
nobind
persist-key
persist-tun
resolv-retry infinite
remote 203.0.113.10 1194 udp
remote 203.0.113.10 8443 tcp
server-poll-timeout 10
remote-cert-tls server
verify-x509-name kaskad-gw-openvpn name
ignore-unknown-option data-ciphers
data-ciphers AES-256-GCM:CHACHA20-POLY1305
tls-version-min 1.2
ignore-unknown-option block-ipv6
block-ipv6
verb 3
block-outside-dns
