[Unit]
Description=Kaskad 3 gateway: OpenConnect inbound (ocserv)
After=network-online.target kaskad-net.service
Wants=network-online.target

[Service]
Type=simple
RuntimeDirectory=kaskad-gw-ocserv
RuntimeDirectoryMode=0755
ExecStart=/usr/sbin/ocserv --foreground --pid-file /run/kaskad-gw-ocserv/ocserv.pid --config /etc/kaskad/gw/ocserv/ocserv.conf
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s
PrivateTmp=true

[Install]
WantedBy=multi-user.target
