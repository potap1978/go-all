[Unit]
Description=Kaskad 3 gateway: WireGuard inbound (kgw-wg)
After=network-online.target kaskad-net.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/kaskad/gw/wg/env
ExecStartPre=-/usr/sbin/ip link delete dev kgw-wg
ExecStart=/usr/sbin/ip link add dev kgw-wg type wireguard
ExecStart=/usr/sbin/wg setconf kgw-wg /etc/wireguard/kgw-wg.conf
ExecStart=/usr/sbin/ip address replace ${ADDR} dev kgw-wg
ExecStart=/usr/sbin/ip link set dev kgw-wg mtu ${MTU} up
ExecReload=/usr/sbin/wg syncconf kgw-wg /etc/wireguard/kgw-wg.conf
ExecStopPost=-/usr/sbin/ip link delete dev kgw-wg

[Install]
WantedBy=multi-user.target
