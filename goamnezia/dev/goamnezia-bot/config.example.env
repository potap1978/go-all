# goAmnezia pro — конфигурация Telegram-бота
# Скопируйте в /opt/goamnezia-bot/.env (права 0600) и заполните.
# install_bot.sh создаёт этот файл сам, спрашивая токен и администратора в терминале.

# Токен бота от @BotFather (обязательно)
BOT_TOKEN=123456789:your_bot_token_from_BotFather

# Telegram ID администраторов через запятую.
# Пустой список = бот НИКОГО не пускает. Первого админа он назначит только тому,
# кто пришлёт одноразовый код из /opt/goamnezia-bot/.admin_claim_code (0600, читает
# только root; нет файла — бот заведёт его при старте) в течение 10 минут после
# запуска — это защита, а не «доступ для всех». Свой ID можно узнать у @userinfobot.
ALLOWED_IDS=123456789

# Владелец: единственный, кто удаляет других админов, и его самого удалить нельзя.
# Пусто — бот запишет того, кто назначится первым по коду.
OWNER_ID=123456789

# Запасной язык бота (ru|en): действует, только пока в config.json goAmnezia нет
# поля lang — язык продукта главнее и меняется «для всех» из SSH, панели и бота.
# Каждый администратор может выбрать свой язык в «Настройки → Язык».
GOAMNEZIA_LANG=ru

# Мост к ядру: путь к install.sh goAmnezia (менять только на стендах).
GOAMNEZIA_ACTION_BIN=/opt/goamnezia/install.sh
