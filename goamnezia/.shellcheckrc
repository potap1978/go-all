# goAmnezia pro — настройки shellcheck (см. docs/CONTRACT.md §7).
# Прогон: shellcheck -S warning -x  (флаг -x разрешает идти по `source`).
#
# Глушим только то, что в этой архитектуре ложное. Всё остальное чиним, а не
# отключаем: список ниже — короткий сознательно.

# SC1090 — «не могу проследить source с переменной в пути».
#   У нас путь к модулю и к словарю всегда собирается из SCRIPT_DIR/LANG_CODE
#   (lib/i18n.sh, lib/selftest.sh), статически он не разрешим в принципе.
# SC1091 — «не могу открыть указанный source».
#   install.sh сорсит /etc/os-release и модули, которых нет в момент проверки
#   (их пишут другие спринты) — это не ошибка кода.
# SC2034 — «переменная присвоена, но не используется».
#   lib/lang/*.sh состоят из присваиваний в I18N, а константы путей и палитра в
#   lib/common.sh используются модулями, которые shellcheck не видит.
disable=SC1090,SC1091,SC2034

# SC2154 — «переменная используется, но не задана» — НЕ отключаем: в коде она
#   ловит настоящие опечатки. В файлах словаря она ложная (I18N[ключ] без
#   declare -gA выглядит для shellcheck как индекс массива), поэтому каждый
#   файл lib/lang/**.sh начинается с `declare -gA I18N`, а tests/run_static.sh
#   на всякий случай гоняет словари с -e SC2154 отдельной пачкой.

# SC2059 — «переменная в формате printf».
#   Ровно на этом стоит tf(): формат приезжает из словаря, а аргументы — от
#   вызывающего. Точечно глушится комментарием в lib/i18n.sh, не здесь.

# Целевая оболочка: bash 5. На macOS это /opt/homebrew/bin/bash, на сервере
# /bin/bash; tests/run_static.sh берёт её через ${BASH5:-bash}.
shell=bash

# Файлы, которые sourcing-цепочка ищет относительно корня репозитория
source-path=SCRIPTDIR
source-path=lib
